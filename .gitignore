# Papers in the Wild — public repo gitignore
#
# RULE: build artifacts and logs from the Next.js site are scoped to site/.
# Episode folders (episodes/*) are content: their build/, build-deeper/,
# runs/, and *.log files are experiment receipts and MUST ship.
# The publish.sh ship-guard fails the deploy if any episodes/ file on disk
# is ignored by a rule in this file.

# ── Maintainer-only deploy script (not for public) ──
publish.sh

# ── Next.js / Node (scoped to the site app) ──
site/node_modules/
site/.next/
site/out/
site/build/
site/dist/
site/.cache/
site/.tmp/
site/*.tsbuildinfo
.env*.local
.env

# ── Editor / OS ──
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ── Logs / runtime (scoped: only tool logs inside site/, never episode receipts) ──
site/**/*.log
site/npm-debug.log*
site/yarn-debug.log*
site/yarn-error.log*
site/pnpm-debug.log*

# ── Python (for any reproduction scripts you keep local) ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
