# Papers in the Wild — public repo gitignore

# ── Maintainer-only deploy script (not for public) ──
publish.sh

# ── Next.js / Node ──
node_modules/
.next/
out/
build/
dist/
.cache/
.tmp/
*.tsbuildinfo
.env*.local
.env

# ── Editor / OS ──
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ── Logs / runtime ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python (for any reproduction scripts you keep local) ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
